APP_ENV=production
DATABASE_URL=postgresql+psycopg://balam:REEMPLAZA_PASSWORD@postgres:5432/balam
SECRET_KEY=GENERA_UNA_CLAVE_ALEATORIA_DE_64_CARACTERES
ACCESS_TOKEN_MINUTES=60
UPLOAD_DIR=/data/uploads
EVENT_TIMEZONE=America/Mexico_City
PAYOUT_AUTO_RELEASE_HOURS=2
PAYOUT_RELEASE_SCAN_SECONDS=60
STRIPE_SECRET_KEY=sk_live_REEMPLAZA
STRIPE_WEBHOOK_SECRET=whsec_REEMPLAZA
BILLING_SUCCESS_URL=https://api.tudominio.com/api/billing/checkout/success?session_id={CHECKOUT_SESSION_ID}
BILLING_CANCEL_URL=https://api.tudominio.com/api/billing/checkout/cancel
CONNECT_REFRESH_URL=https://api.tudominio.com/api/billing/connect/refresh
CONNECT_RETURN_URL=https://api.tudominio.com/api/billing/connect/return
CORS_ORIGINS=https://app.tudominio.com
ALLOWED_HOSTS=api.tudominio.com
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800
DATABASE_CONNECT_TIMEOUT=10
# Para AWS RDS usa require, o verify-full junto con el certificado CA montado.
DATABASE_SSL_MODE=require
# DATABASE_SSL_ROOT_CERT=/run/secrets/rds-ca.pem
SMTP_HOST=smtp.tu-proveedor.com
SMTP_PORT=587
SMTP_USERNAME=REEMPLAZA_USUARIO
SMTP_PASSWORD=REEMPLAZA_PASSWORD
SMTP_FROM_EMAIL=no-reply@tudominio.com
SMTP_FROM_NAME=Balam
SMTP_STARTTLS=true
EXPOSE_PASSWORD_RESET_CODE=false
GOOGLE_CLIENT_IDS=882316037020-3tgmqu1p4vn8g187aam0svvo8cmr1l0g.apps.googleusercontent.com
MAX_IMAGE_BYTES=8388608
MAX_VIDEO_BYTES=104857600
MAX_REQUEST_BODY_BYTES=2097152
MAX_STRIPE_WEBHOOK_BYTES=1048576
# Déjalo en false cuando Oracle se exponga directamente mediante Caddy/Nginx.
TRUST_CLOUDFLARE_HEADERS=false
AUTH_RATE_LIMIT_PER_MINUTE=10
PASSWORD_RESET_RATE_LIMIT_PER_HOUR=5
