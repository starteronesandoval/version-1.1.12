APP_ENV=development
DATABASE_URL=sqlite:///./balam.db
SECRET_KEY=development-only-secret-key-change-me
ACCESS_TOKEN_MINUTES=10080
UPLOAD_DIR=uploads
EVENT_TIMEZONE=America/Mexico_City
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
PASSWORD_RESET_WEBHOOK_URL=
PASSWORD_RESET_WEBHOOK_TOKEN=
# Sólo para desarrollo local; staging/production rechazan este valor.
EXPOSE_PASSWORD_RESET_CODE=true
MAX_IMAGE_BYTES=8388608
MAX_VIDEO_BYTES=104857600
