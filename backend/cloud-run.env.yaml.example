# Copia este archivo como cloud-run.env.yaml y sustituye los dominios públicos.
# No pongas secretos aquí: DATABASE_URL, SECRET_KEY, Stripe y SMTP se inyectan
# desde Secret Manager mediante --update-secrets.
APP_ENV: production
UPLOAD_DIR: /tmp/uploads
EVENT_TIMEZONE: America/Mexico_City
ACCESS_TOKEN_MINUTES: "60"
CORS_ORIGINS: https://app.tudominio.com,https://www.tudominio.com
ALLOWED_HOSTS: api.tudominio.com,garibaldi-api-REEMPLAZA-uc.a.run.app
DATABASE_POOL_SIZE: "5"
DATABASE_MAX_OVERFLOW: "5"
DATABASE_POOL_TIMEOUT: "30"
DATABASE_POOL_RECYCLE: "1800"
DATABASE_CONNECT_TIMEOUT: "10"
# El conector de Cloud SQL cifra el trayecto hasta Cloud SQL; el socket local no usa TLS.
DATABASE_SSL_MODE: disable
BILLING_SUCCESS_URL: https://api.tudominio.com/api/billing/checkout/success?session_id={CHECKOUT_SESSION_ID}
BILLING_CANCEL_URL: https://api.tudominio.com/api/billing/checkout/cancel
CONNECT_REFRESH_URL: https://api.tudominio.com/api/billing/connect/refresh
CONNECT_RETURN_URL: https://api.tudominio.com/api/billing/connect/return
SMTP_PORT: "587"
SMTP_FROM_EMAIL: no-reply@tudominio.com
SMTP_FROM_NAME: Balam
SMTP_STARTTLS: "true"
GOOGLE_CLIENT_IDS: REEMPLAZA_CON_CLIENT_ID_WEB.apps.googleusercontent.com
FCM_PROJECT_ID: REEMPLAZA_CON_PROYECTO_FIREBASE
PAYOUT_RELEASE_SCAN_SECONDS: "60"
PUSH_SCAN_SECONDS: "15"
MAX_IMAGE_BYTES: "8388608"
MAX_VIDEO_BYTES: "104857600"
MAX_REQUEST_BODY_BYTES: "2097152"
MAX_STRIPE_WEBHOOK_BYTES: "1048576"
AUTH_RATE_LIMIT_PER_MINUTE: "10"
PASSWORD_RESET_RATE_LIMIT_PER_HOUR: "5"
EXPOSE_PASSWORD_RESET_CODE: "false"
TRUST_CLOUDFLARE_HEADERS: "false"
