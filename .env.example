# Copia este archivo como .env únicamente en el servidor. Nunca lo subas a Git.
POSTGRES_PASSWORD=REEMPLAZA_CON_CONTRASENA_LARGA_ALEATORIA
SECRET_KEY=REEMPLAZA_CON_SECRETO_JWT_DE_AL_MENOS_32_CARACTERES

# API pública de producción.
API_DOMAIN=api.tudominio.com
CORS_ORIGINS=https://api.tudominio.com
ALLOWED_HOSTS=api.tudominio.com

# Stripe: usa llaves live o test según el entorno, nunca ambas mezcladas.
STRIPE_SECRET_KEY=REEMPLAZA_CON_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=REEMPLAZA_CON_STRIPE_WEBHOOK_SECRET
BILLING_SUCCESS_URL=https://api.tudominio.com/api/billing/checkout/success?session_id={CHECKOUT_SESSION_ID}
BILLING_CANCEL_URL=https://api.tudominio.com/api/billing/checkout/cancel
CONNECT_REFRESH_URL=https://api.tudominio.com/api/billing/connect/refresh
CONNECT_RETURN_URL=https://api.tudominio.com/api/billing/connect/return

# Correo transaccional.
SMTP_HOST=REEMPLAZA_CON_SERVIDOR_SMTP
SMTP_PORT=587
SMTP_USERNAME=REEMPLAZA_CON_USUARIO_SMTP
SMTP_PASSWORD=REEMPLAZA_CON_CONTRASENA_SMTP
SMTP_FROM_EMAIL=no-reply@tudominio.com
SMTP_FROM_NAME=Balam
SMTP_STARTTLS=true

# Google y Firebase. La ruta es local a la VM y el JSON no entra a Git.
GOOGLE_CLIENT_IDS=REEMPLAZA_CON_CLIENT_ID_DE_GOOGLE
FCM_PROJECT_ID=REEMPLAZA_CON_PROYECTO_FIREBASE
FCM_CREDENTIALS_HOST_PATH=/opt/garibaldi/secrets/firebase-service-account.json

# Archivos privados del túnel Cloudflare existentes en la VM, fuera de Git.
CLOUDFLARE_CONFIG_HOST_PATH=/opt/garibaldi/secrets/cloudflared-config.yml
CLOUDFLARE_CREDENTIALS_HOST_PATH=/opt/garibaldi/secrets/cloudflared-credentials.json

ACCESS_TOKEN_MINUTES=60
TRUST_CLOUDFLARE_HEADERS=true
DATABASE_SSL_MODE=prefer
